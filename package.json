{
  "name": "chat-bubble",
  "version": "1.0.0",
  "description": "Active local workspace for the YouTube-targeted adaptive chat bubble.",
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node --env-file=src/server/.env src/server/index.js",
    "check": "node --check src/server/index.js && node --check src/server/adapter.js && node --check src/server/sse_hub.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:nameplate": "vite src/nameplate --host 127.0.0.1 --port 5173 --open /nameplate.html",
    "dev:avatarbox": "vite src/avatarbox --host 127.0.0.1 --port 5174 --open /avatarbox.html",
    "dev:messagebox": "vite src/messagebox --host 127.0.0.1 --port 5175 --open /messagebox.html",
    "dev:renderer": "vite \"src/message renderer\" --host 127.0.0.1 --port 5176 --open /message_renderer.html",
    "render:page": "node tools/render-page.mjs",
    "render:messagebox": "node tools/render-page.mjs src/messagebox/messagebox.html tests/screenshots/messagebox.png",
    "scan:release": "node tools/virustotal-scan.mjs src/server/release/ChatBubble.zip src/server/release",
    "test": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "google-proto-files": "^5.0.2"
  }
}
